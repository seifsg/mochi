{
  "name": "mochi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A cute desk mascot that pops helpful tips on your screen.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app:ui": "vite --config app/vite.config.ts",
    "app:ui:build": "vite build --config app/vite.config.ts",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-log": "^2.10.1"
  }
}
